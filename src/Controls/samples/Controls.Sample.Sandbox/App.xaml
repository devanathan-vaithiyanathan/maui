<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui.Controls.Sample"
             x:Class="Maui.Controls.Sample.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

            </ResourceDictionary.MergedDictionaries>

            <!-- Colors -->
            <Color x:Key="Primary">#512BD4</Color>
            <Color x:Key="Black">Black</Color>
            <Color x:Key="White">White</Color>
            <Color x:Key="LinkColor">#0066CC</Color>

            <!-- Styles for FormattedString custom-font tap repro -->
            <Style x:Key="CustomBody" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LineHeight" Value="1.5" />
                <Setter Property="FontFamily" Value="MyCustomFont" />
            </Style>

            <Style x:Key="CustomBodyLink" TargetType="Label" BasedOn="{StaticResource CustomBody}">
                <Setter Property="TextDecorations" Value="Underline" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
