<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Maui.Controls.Sample.DetailPage1"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="DetailPage1">
    <Grid Padding="24"
            RowDefinitions="*,Auto"
            RowSpacing="16">
        <Label
            AutomationId="DetailPageLabel"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Text="FlyoutPage scenario&#10;&#10;Close the flyout, then press the Android back button. The app should remain open and show a FlyoutPage alert."
            VerticalOptions="Center"/>
        <Button
            AutomationId="OpenScenarioFlyoutButton"
            Grid.Row="1"
            Clicked="OnOpenFlyoutClicked"
            Text="Choose another scenario"/>
    </Grid>
</ContentPage>