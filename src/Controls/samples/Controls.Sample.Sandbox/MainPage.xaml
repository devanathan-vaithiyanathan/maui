<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Controls.Sample.MainPage"
             xmlns:local="clr-namespace:Maui.Controls.Sample"
             Title="SelectedItem Reproduction">

    <Grid Padding="24">
        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="16">
            <Label
                FontSize="18"
                HorizontalTextAlignment="Center"
                Text="Navigate to the CollectionView page. The cyan item should already be selected."/>
            <Button
                AutomationId="NavigateButton"
                Clicked="OnNavigateClicked"
                Text="Navigate to CollectionView"/>
        </VerticalStackLayout>
    </Grid>
    <Button
        AutomationId="Sample1Button"
        Clicked="OnSample1Clicked"
        Text="1"/>
    <Button
        AutomationId="Sample2Button"
        Clicked="OnSample2Clicked"
        Text="2"/>
    <Button
        AutomationId="Sample3Button"
        Clicked="OnSample3Clicked"
        Text="3"/>
    </VerticalStackLayout>
    </Grid>
</ContentPage>