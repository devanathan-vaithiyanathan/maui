       <ContentPage.Content>

              <StackLayout>
                     <Label HeightRequest="100"/>
                     <IndicatorView FlowDirection="RightToLeft"
                                    x:Name="indicatorView"
                                   Background="Yellow"
                                    HorizontalOptions="Center">
                            <IndicatorView.IndicatorTemplate>
                                   <DataTemplate>
                                          <Border
                                                 WidthRequest="20"
                                                 HeightRequest="20"
                                                 Stroke="Red"
                                                 StrokeThickness="1"
                                                 StrokeShape="RoundRectangle 10">
                                                 <Label
                                                        Text="●"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"/>
                                          </Border>
                                   </DataTemplate>
                            </IndicatorView.IndicatorTemplate>
                     </IndicatorView>
                     <Button Text="Change"
                             Clicked="Button_Clicked"/>
              </StackLayout>

       </ContentPage.Content>

