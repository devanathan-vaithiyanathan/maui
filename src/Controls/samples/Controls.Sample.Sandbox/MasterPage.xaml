<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage
    x:Class="Maui.Controls.Sample.MasterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="MasterPage">
    <FlyoutPage.Flyout>
        <ContentPage Title="Back button scenarios">
            <Grid Padding="24"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="12">
                <Label
                    AutomationId="FlyoutLabel"
                    Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="Choose a root page"/>
                <Button
                    AutomationId="ShowContentPageButton"
                    Grid.Row="1"
                    Clicked="OnShowContentPageClicked"
                    Text="ContentPage override"/>
                <Button
                    AutomationId="ShowNavigationPageButton"
                    Grid.Row="2"
                    Clicked="OnShowNavigationPageClicked"
                    Text="NavigationPage override"/>
                <Button
                    AutomationId="CloseFlyoutButton"
                    Grid.Row="3"
                    Clicked="OnCloseFlyoutClicked"
                    Text="Test FlyoutPage override"/>
            </Grid>
        </ContentPage>
    </FlyoutPage.Flyout>
    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <ContentPage/>
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>